# ============================================================================
# Northstar Labs Sales Intelligence — environment template
# Copy this file to `backend/.env` and fill in the values you have.
# NEVER commit `.env` or real keys to source control.
# ============================================================================

# ----- Application ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — comma-separated exact origins allowed to call the API.
# Leave CORS_ORIGIN_REGEX for local dev (permits any localhost port); set it
# empty in production and list real origins in CORS_ORIGINS instead.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# ----- LLM provider (provider-agnostic layer) -------------------------------
# one of: openrouter | deepseek | ollama
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=90

# OpenRouter (primary)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek direct (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama (local / offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180

# ----- Research -------------------------------------------------------------
# mock = use local files in northstar/mock (no external APIs)
# live = call the configured search provider / website / X
RESEARCH_MODE=mock

# How problem evaluation, solution matching and outreach are generated:
#   auto      -> heuristic in mock mode, LLM in live mode (default)
#   llm       -> always try the LLM (falls back to heuristic on failure)
#   heuristic -> always use deterministic rules (no LLM)
ANALYSIS_MODE=auto

# Which search backend live mode uses: tinyfish | tavily
SEARCH_PROVIDER=tinyfish

# TinyFish — free Search + Fetch (needs an X-API-Key; Search API access)
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_LOCATION=US
TINYFISH_LANGUAGE=en

# Tavily — alternative search backend (used when SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

TOP_K_PER_QUERY=5
MAX_QUERIES=5
MAX_EVIDENCE=12
REQUEST_TIMEOUT=30

# X API — optional. If absent the X node is a no-op (no scraping).
X_API_BEARER_TOKEN=
X_API_BASE_URL=https://api.twitter.com/2

# ----- Storage / RAG --------------------------------------------------------
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
